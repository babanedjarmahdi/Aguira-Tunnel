{
  "name": "terraflow",
  "version": "0.1.0",
  "private": true,
  "description": "TerraFlow - Configurable Real Estate Import Engine (monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "extract": "node packages/engine/src/cli.js extract",
    "loaddb": "node packages/engine/src/cli.js loaddb",
    "ai": "node packages/engine/src/cli.js ai",
    "fill": "node packages/engine/src/cli.js fill",
    "fill:original": "node packages/engine/src/cli.js fill:original",
    "pipeline": "node packages/engine/src/cli.js pipeline",
    "watch": "node packages/engine/src/cli.js watch",
    "api": "node apps/api/src/server.js",
    "dev": "npm -w @terraflow/web run dev",
    "build": "npm -w @terraflow/web run build",
    "preview": "npm -w @terraflow/web run preview",
    "test": "node --test \"packages/*/test/**/*.test.js\""
  }
}
